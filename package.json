{
  "name": "uptimeflare",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "esbuild tests/telegram-alerts.ts tests/next16-dashboard.ts --bundle --platform=node --format=cjs --external:cloudflare:* --outdir=.tmp/checks && node .tmp/checks/telegram-alerts.js && node .tmp/checks/next16-dashboard.js",
    "check:runtime": "node tests/cloudflare-runtime.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@tabler/icons-react": "3.48.0",
    "chart.js": "4.5.1",
    "i18next": "25.10.10",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.0",
    "react-i18next": "16.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@opennextjs/cloudflare": "1.20.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "miniflare": "5.20261006.0-alpha",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "wrangler": "4.148.0"
  }
}
