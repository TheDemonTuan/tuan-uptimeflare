{
  "name": "uptimeflare",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "esbuild tests/telegram-alerts.ts tests/next16-dashboard.ts --bundle --platform=node --format=cjs --external:cloudflare:* --outdir=.tmp/checks && node .tmp/checks/telegram-alerts.js && node .tmp/checks/next16-dashboard.js",
    "check:runtime": "node tests/cloudflare-runtime.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.8.2",
    "@mantine/hooks": "9.8.2",
    "@tabler/icons-react": "3.53.0",
    "chart.js": "4.6.2",
    "i18next": "27.2.7",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@opennextjs/cloudflare": "1.20.18",
    "@types/node": "24.19.2",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "miniflare": "5.20261123.1-beta",
    "postcss": "8.5.33",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "wrangler": "4.168.0"
  }
}
